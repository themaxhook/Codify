# Stage 1: Build the React App
FROM node:18-alpine as build
WORKDIR /app
COPY package*.json ./
# Install all dependencies (including frontend ones)
RUN npm install
COPY . .
# This compiles your React code inside the 'src' folder
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine
# Assumes standard React build folder. If using Vite, change /build to /dist
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]